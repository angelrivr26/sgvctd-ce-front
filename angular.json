{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "comprobantes": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/comprobantes",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "src/assets", "output": "assets" }],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "650kB", "maximumError": "900kB" },
                { "type": "anyComponentStyle", "maximumWarning": "12kB", "maximumError": "20kB" }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "test": {
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.test.ts"
                }
              ]
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "host": "localhost", "port": 4205 },
          "configurations": {
            "development": {
              "buildTarget": "comprobantes:build:development",
              "proxyConfig": "proxy.conf.json"
            },
            "test": {
              "buildTarget": "comprobantes:build:test",
              "proxyConfig": "proxy.desarrollo.conf.json"
            },
            "production": {
              "buildTarget": "comprobantes:build:production",
              "proxyConfig": "proxy.desarrollo.conf.json"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
